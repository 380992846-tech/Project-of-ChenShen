# ===== 必填 =====
# 复制本文件为 .env 并填入你的 Key（.env 已被 gitignore，不会入库）
DEEPSEEK_API_KEY=sk-your-key

# ===== 可选覆盖 =====
DEEPSEEK_BASE_URL=https://api.deepseek.com
DSH_MODEL=deepseek-chat
DSH_TEMPERATURE=0.7
DSH_VOICE=zh-CN-YunxiNeural
DSH_SPEAK=1
DSH_STREAM=1
DSH_MAX_ROUNDS=20
DSH_LOG_LEVEL=INFO
# ===== 多模型（Web 界面）=====
# 下面三个用于「多模型 Web 界面」：前端下拉可选的三个模型，各自对应一个 API 模型标识。
#   1) 标识参考 DeepSeek 官方「模型 & 价格」表：
#      https://api-docs.deepseek.com/zh-cn/quick_start/pricing/
#   2) BASE URL 统一用 DEEPSEEK_BASE_URL，连接 OpenAI 兼容格式（/chat/completions）。
#   3) 若删掉某一行（或留空），该模型会回退到上面的 DSH_MODEL（默认 deepseek-chat）。
#   4) 改完后在 Web 界面直接选中即可调用；也可在网页顶部把「模型 ID」改成你的真实标识。
DSH_MODEL_PRO=deepseek-v4-pro                       # V4 Pro（通用对话，能力最强）
DSH_MODEL_FLASH=deepseek-v4-flash                   # V4 Flash（轻量，响应更快）
DSH_MODEL_VISION=deepseek-v4-flash-vision-exp       # V4 Flash 视觉（支持图像输入）
# 对话历史/数据目录（默认 ~/.dsh_assistant）
# DSH_DATA_DIR=/path/to/data
