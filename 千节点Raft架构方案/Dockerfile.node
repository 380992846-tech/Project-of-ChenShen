# Dockerfile.node
# 数据节点（kvstore-node）容器镜像
# 构建：
#   docker build -f Dockerfile.node -t kvstore-node:latest .
# 运行（以单节点调试为例）：
#   docker run --rm --network host kvstore-node:latest \
#       --node-id node-0-0 --shard-id 0 \
#       --bind-addr 127.0.0.1:8000 \
#       --raft-dir /var/lib/kvstore \
#       --metadata http://localhost:2370 --bootstrap

# --- 构建阶段 ---
FROM golang:1.21-alpine AS builder

WORKDIR /src

# 先复制依赖文件，充分利用缓存
COPY go.mod go.sum ./
RUN go mod download

# 复制源码并构建数据节点
COPY . .
RUN CGO_ENABLED=0 go build -ldflags="-s -w" -o /bin/kvstore-node ./cmd/kvstore-node

# --- 运行阶段 ---
FROM alpine:3.19

RUN apk --no-cache add ca-certificates tzdata

# 非 root 运行
RUN addgroup -S kvstore && adduser -S -G kvstore kvstore

COPY --from=builder /bin/kvstore-node /usr/local/bin/kvstore-node

# Raft 数据目录
RUN mkdir -p /var/lib/kvstore && chown -R kvstore:kvstore /var/lib/kvstore

USER kvstore

ENV LISTEN_ADDR=":8080"
EXPOSE 9100

VOLUME ["/var/lib/kvstore"]

ENTRYPOINT ["kvstore-node"]
